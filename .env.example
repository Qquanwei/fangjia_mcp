# 线上由 Vercel 的 Supabase 集成注入。本地用 vercel env pull 获取。
# SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY 或 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# SUPABASE_SECRET_KEY 或 SUPABASE_SERVICE_ROLE_KEY
# Google 登录在 Supabase Auth 里配置，不写进这个文件。

# 杭州市数据开放平台申请通过后，二选一
HZ_APP_SECRET=
HZ_USER_SECRET=

# 本地同步：每轮页数、每页条数
SYNC_MAX_PAGES=20
SYNC_PAGE_SIZE=100

# Vercel Cron 调用 /api/cron/sync 时校验
CRON_SECRET=
